# APP
PORT=:8080
SWAGGER_PORT=:8081

# Database
DB_URL=postgres://maywalk:123456@localhost:5432/maywalk
DB_USER=maywalk
DB_NAME=maywalk
DB_PASSWORD=123456
DB_MIGRATION_PATH=./migrations
DB_AUTOMIGRATRE=true
DB_MIGRATE_URL=pgx5://maywalk:123456@localhost:5432/maywalk

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_MAX_RETRIES=3

# Logger
LOG_LEVEL=INFO
LOG_FORMAT=PLAIN

# Sessions
SESS_IDLE_TIMEOUT=8h
SESS_REMEMBER_TIMEOUT=30d
SESS_SECRET=SECRET_KEY==

# OAuth
OAUTH_YA_CLIENT_ID=YANDEX_CLIENT_ID
OAUTH_YA_CLIENT_SECRET=YANDEX_CLIENT_SECRET
OAUTH_YA_REDIRECT_URL=http://localhost:8080/user/signin/yandex/callback