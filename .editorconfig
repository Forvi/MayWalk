root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.{js,jsx,mjs,cjs,ts,tsx}]
indent_style = space
indent_size = 2

[*.{css,scss,less}]
indent_style = space
indent_size = 2

[*.html]
indent_style = space
indent_size = 2

[*.json]
indent_size = 2
indent_style = space

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[{Makefile,*.mk,*.am}]
indent_style = tab
indent_size = 4